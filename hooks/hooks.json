{
  "description": "Display a compact local token-usage summary when a Codex turn stops.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/plugin/scripts/usage_hook.py\"",
            "commandWindows": "py -3 \"$env:PLUGIN_ROOT\\plugin\\scripts\\usage_hook.py\"",
            "timeout": 20,
            "statusMessage": "Summarizing local Codex usage"
          }
        ]
      }
    ]
  }
}
